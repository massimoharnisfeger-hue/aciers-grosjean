# Envoi des demandes de devis — app/api/devis/route.ts
#
# Copier ce fichier en `.env.local` (ignoré par git) et remplir les valeurs.
# Sur Vercel : Settings → Environment Variables, environnement Production.
#
# Sans ces variables, la route répond 503 et le formulaire ouvre la messagerie
# du visiteur, comme avant : rien ne casse, mais rien n'est tracé côté entreprise.
#
# Microsoft 365 : la boîte doit avoir « SMTP AUTH » activé (centre d'administration
# Exchange → boîte aux lettres → Messagerie → Authentification SMTP). C'est
# désactivé par défaut sur la plupart des tenants.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Boîte qui reçoit les demandes. Vide : `site.email` de lib/content.ts.
DEVIS_DESTINATAIRE=

# Catalogue visuel (/catalogue, /catalogue/<univers>, /catalogue/imprimer) — ADR-0010.
# Il ne se construit que si cette variable vaut `oui`. Sur le PC : oui, pour
# relire le catalogue et exporter le PDF (scripts/catalogue/exporter_pdf.py).
# Sur Vercel : absente tant que le catalogue n'est pas validé par le propriétaire.
CATALOGUE_LOCAL=
